# Copia este archivo a ".env" y completa tus propios valores.
# Nunca subas el archivo ".env" real a un repositorio.

# Puerto en el que escucha el servidor
PORT=3000

# Secreto para firmar los tokens de sesión (JWT).
# Genera uno único y largo, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-secreto-largo-y-unico

# Duración de la sesión antes de pedir iniciar sesión de nuevo
JWT_EXPIRES_IN=12h

# Origen permitido para CORS (el dominio donde vive tu frontend).
# En desarrollo puedes dejarlo vacío o usar "*"; en producción pon tu dominio real, ej:
# CORS_ORIGIN=https://plan.gamarraleadership.com
CORS_ORIGIN=

# Ruta del archivo de base de datos SQLite (opcional, por defecto usa ./data/lidera_tu_vida.sqlite)
DB_PATH=

# --- Correo (para avisos de "semaforo en rojo") ---
# Si dejas SMTP_HOST vacio, la app NO falla: simplemente escribe en la consola
# del servidor el correo que habria enviado, para que puedas seguir probando
# sin tener un proveedor de correo configurado todavia.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lidera tu Vida <no-reply@tudominio.com>
